# ----------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copiar a `.env` antes de correr docker compose y rellenar los valores.
# NUNCA subir el archivo .env real a git.
# ----------------------------------------------------------------------------

# -- Configuración MySQL ------------------------------------------------------
MYSQL_NOMBRE_BD=registros_eafit
MYSQL_USUARIO=usuario_app
MYSQL_PASSWORD_USUARIO=cambiar_este_password_seguro
MYSQL_PASSWORD_ROOT=cambiar_este_password_root_seguro

# -- Configuración SMTP para envío de reportes --------------------------------
# Si usas Gmail, debes crear una "App password" en tu cuenta de Google.
# https://support.google.com/accounts/answer/185833
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
CORREO_REMITENTE=tu_correo@gmail.com

# Destinatario fijo según consigna del proyecto
CORREO_DESTINATARIO=ialondonoo@eafit.edu.co
